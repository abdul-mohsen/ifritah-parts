# Example .env — copy to .env and edit.
# The server boots even when values are missing; every field has a sensible
# default in internal/config/config.go. Real deployments must override at
# least CORS_ORIGINS and (for prod) PGPASSWORD.

# ── Server ────────────────────────────────────────────
BIND_ADDR=0.0.0.0
PORT=8080
DATA_DIR=./data

# ── PostgreSQL (owned catalog, sqlc-generated store, primary DB) ──
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=55432
PGHOST_PORT=55432
PGUSER=parts
PGPASSWORD=parts_engine_pw
PGDATABASE=parts_engine
PGSSLMODE=disable

# ── MySQL / TecDoc (optional — the "big data" on the server) ──
# When MYSQL_HOST is empty the app runs on Postgres + SQLite alone and the
# /health endpoint reports tecdoc:false. Set MYSQL_HOST to the production
# MySQL box to enable the 21.5M-row oem_number + articlesvehicletrees +
# articlecrosses tables inside the SmartSearch cascade.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dev_ifritah

# ── CORS ──────────────────────────────────────────────
# Must be an explicit allowlist. If you set CORS_ORIGINS=* the server
# refuses to enable AllowCredentials and logs a warning.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External APIs ─────────────────────────────────────
ELASTIC_URL=http://localhost:9200
NHTSA_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_RECALLS_URL=https://api.nhtsa.gov/recalls
